{"1":{"view":[0,0,612,792],"rotate":0,"items":[{"str":"Notes on careful measurement","transform":[20,0,0,20,72,720],"width":292.32,"height":20,"fontName":"g_d13_f1","dir":"ltr","hasEOL":false},{"str":"","transform":[14,0,0,14,72,664],"width":0,"height":0,"fontName":"g_d13_f2","dir":"ltr","hasEOL":true},{"str":"Every instrument tells you something about the world and","transform":[14,0,0,14,72,664],"width":355.642,"height":14,"fontName":"g_d13_f2","dir":"ltr","hasEOL":true},{"str":"something about itself. The trick is learning which is which","transform":[14,0,0,14,72,642],"width":358.48,"height":14,"fontName":"g_d13_f2","dir":"ltr","hasEOL":true},{"str":"before you write anything down. A careful measurement is","transform":[14,0,0,14,72,620],"width":358.775,"height":14,"fontName":"g_d13_f2","dir":"ltr","hasEOL":true},{"str":"repeated, and its spread is reported with its value.","transform":[14,0,0,14,72,598],"width":308.963,"height":14,"fontName":"g_d13_f2","dir":"ltr","hasEOL":true},{"str":"Keep the raw numbers. They outlast the story told about them.","transform":[14,0,0,14,72,554],"width":386.53,"height":14,"fontName":"g_d13_f2","dir":"ltr","hasEOL":false}],"styles":{"g_d13_f1":{"ascent":0.77001953125,"descent":-0.22998046875},"g_d13_f2":{"ascent":0.77001953125,"descent":-0.22998046875}}},"2":{"view":[0,0,612,792],"rotate":0,"items":[{"str":"Waves and patterns","transform":[20,0,0,20,72,720],"width":188.212,"height":20,"fontName":"g_d13_f1","dir":"ltr","hasEOL":false},{"str":"","transform":[14,0,0,14,72,664],"width":0,"height":0,"fontName":"g_d13_f2","dir":"ltr","hasEOL":true},{"str":"A wave carries a pattern without carrying the stuff it moves","transform":[14,0,0,14,72,664],"width":361.595,"height":14,"fontName":"g_d13_f2","dir":"ltr","hasEOL":true},{"str":"through. Watch a cork on a pond: it bobs, and stays.","transform":[14,0,0,14,72,642],"width":323.24,"height":14,"fontName":"g_d13_f2","dir":"ltr","hasEOL":false}],"styles":{"g_d13_f1":{"ascent":0.77001953125,"descent":-0.22998046875},"g_d13_f2":{"ascent":0.77001953125,"descent":-0.22998046875}}}}